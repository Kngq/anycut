{
  "name": "anycut",
  "productName": "anycut",
  "version": "0.1.1",
  "description": "A free, open-source desktop video editor inspired by CapCut.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kngq/anycut.git"
  },
  "private": true,
  "type": "module",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "node scripts/buildNative.mjs && vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build && node scripts/buildNative.mjs",
    "preview": "vite preview",
    "test:export": "tsx scripts/testExport.ts",
    "test:export:speed": "tsx scripts/testExportSpeed.ts",
    "test:export:reverse": "tsx scripts/testExportReverse.ts",
    "test:export:freeze": "tsx scripts/testExportFreeze.ts",
    "test:export:keyframes": "tsx scripts/testExportKeyframes.ts",
    "test:export:effects": "tsx scripts/testExportEffects.ts",
    "test": "vitest run",
    "dist": "npm run build && node scripts/fetchFfmpeg.mjs && electron-builder --publish never"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.7.6",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "uuid": "^9.0.1",
    "vite": "^5.3.3",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^2.1.9",
    "zustand": "^4.5.4"
  },
  "build": {
    "appId": "app.anycut.editor",
    "productName": "anycut",
    "copyright": "anycut contributors",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json",
      "!node_modules/**/*.{md,markdown,map,ts}",
      "!node_modules/ffprobe-static/bin/**",
      "node_modules/ffprobe-static/bin/${platform}/${arch}/**",
      "!node_modules/onnxruntime-node/bin/**",
      "node_modules/onnxruntime-node/bin/napi-v*/${platform}/${arch}/**"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**",
      "node_modules/onnxruntime-node/**",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "artifactName": "anycut-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.video",
      "icon": "build/icon.icns",
      "target": [
        "dmg"
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "extraResources": [
        {
          "from": "native-bin/anycut-matte",
          "to": "anycut-matte"
        }
      ]
    },
    "dmg": {
      "artifactName": "anycut-mac-${arch}.${ext}"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "anycut-windows-setup.${ext}"
    },
    "linux": {
      "icon": "build/icon-full.png",
      "category": "AudioVideo",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "anycut-linux-x86_64.${ext}"
    }
  },
  "allowScripts": {
    "electron@31.7.7": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "ffmpeg-static@5.3.0": true,
    "fsevents@2.3.3": true
  }
}
